# Copy to .env (never commit .env). Every value has a working default, so .env is optional locally.

# Where segments / parking / closures come from: "local" (committed files + fixtures) or "mongo" (Atlas)
DATA_BACKEND=local
# Needed only when DATA_BACKEND=mongo. Same variable name as data-pipeline/.env.
# Paste the password without the < > brackets (they make Atlas answer "bad auth").
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=flood

# true = allow anonymous fixture calendar requests; connected sessions always use their selected source
USE_FAKE_CALENDAR=true

# Google Calendar: obtain a Web application OAuth client in Google Cloud.
# Keep credentials on the backend. See docs/google-calendar-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
CALENDAR_COOKIE_SECURE=false
CALENDAR_COOKIE_SAMESITE=lax

# Frontend origins allowed by CORS (JSON list). Add the Vercel URL when deployed.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:3000"]

# Optional: traffic-aware drive times (free key from developer.tomtom.com). Empty = speed limits only.
TOMTOM_API_KEY=

# NWS flood alerts + Biscayne Bay tide for /alerts (free, no key). false = trip alerts only.
LIVE_CONDITIONS_ENABLED=true
